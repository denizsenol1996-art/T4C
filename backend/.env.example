# ══════════════════════════════════════════════════════════
# T4C / CardDatax — Environment Configuration
# ══════════════════════════════════════════════════════════
# Kopieer dit bestand naar .env en vul je keys in:
#   copy .env.example .env
#
# NOOIT .env committen of delen! Staat in .gitignore.
# ══════════════════════════════════════════════════════════

# ── Server ──
PORT=3000
NODE_ENV=production
JWT_SECRET=

# ── OpenAI (GPT-4o) ──
# Haal je key op: https://platform.openai.com/api-keys
# Kost: ~$0.005 per taxatie-analyse
OPENAI_API_KEY=sk-...

# ── Vinacles (NAP + voertuighistorie) ──
# Contact: 085-0653770 of rdw@vinacles.com
VINACLES_API_KEY=
VINACLES_API_URL=

# ── CARFAX (schadeverleden) ──
# Contact: carfax.eu/nl → Partner programma
CARFAX_API_KEY=
CARFAX_API_URL=

# ── Anthropic (Claude AI — optioneel, second opinion) ──
ANTHROPIC_API_KEY=

# ── Finnik (marktdata — later) ──
FINNIK_API_KEY=
